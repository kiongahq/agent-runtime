{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kionga.dev/schemas/agent-team/runner-turn-request/v1.json",
  "title": "Kionga runner turn request",
  "description": "Body of POST /agent-turns on the designer runner: one model call, stored nowhere. The gateway sends it with Authorization: Bearer $KIONGA_DESIGNER_RUNNER_TOKEN. Messages must never contain credentials. Closed contract, so there is no field in which to pass one.",
  "type": "object",
  "required": [
    "run_id",
    "worker_id",
    "turn",
    "model",
    "system",
    "messages",
    "tools",
    "max_output_tokens"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^atr-[a-f0-9]{24}$"
    },
    "worker_id": {
      "type": "string",
      "pattern": "^atw-[a-f0-9]{24}$"
    },
    "turn": {
      "type": "integer",
      "minimum": 1
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "system": {
      "type": "string"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "tool_call": {
      "type": "object",
      "required": [
        "id",
        "name",
        "arguments"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        },
        "arguments": {
          "type": "object"
        }
      }
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "description",
        "input_schema"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        },
        "description": {
          "type": "string"
        },
        "input_schema": {
          "type": "object"
        }
      }
    },
    "message": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "role",
            "content"
          ],
          "additionalProperties": false,
          "properties": {
            "role": {
              "const": "user"
            },
            "content": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "role",
            "content"
          ],
          "additionalProperties": false,
          "properties": {
            "role": {
              "const": "assistant"
            },
            "content": {
              "type": "string"
            },
            "tool_calls": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/tool_call"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "role",
            "tool_call_id",
            "content"
          ],
          "additionalProperties": false,
          "properties": {
            "role": {
              "const": "tool"
            },
            "tool_call_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "content": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
